{
  "name": "angularlogoscom",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration=production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint --fix",
    "lint:ci": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json}\" \"*.{json,mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json}\" \"*.{json,mjs,ts}\""
  },
  "dependencies": {
    "@angular/cdk": "22.1.0",
    "@angular/common": "22.1.0",
    "@angular/compiler": "22.1.0",
    "@angular/core": "22.1.0",
    "@angular/forms": "22.1.0",
    "@angular/material": "22.1.0",
    "@angular/platform-browser": "22.1.0",
    "@angular/router": "22.1.0",
    "normalize.css": "8.0.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "22.1.2",
    "@angular/compiler-cli": "22.1.0",
    "@eslint/js": "10.0.1",
    "@vitest/browser-playwright": "4.1.10",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@vitest/eslint-plugin": "1.6.26",
    "angular-eslint": "22.1.0",
    "eslint": "10.8.1",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "pretty-quick": "4.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10",
    "vitest-browser-angular": "0.5.0"
  },
  "engines": {
    "node": "=26.5.0",
    "pnpm": ">=11.20.0"
  },
  "engineStrict": true
}
